# Telegram bot token from @BotFather
BOT_TOKEN=put_your_bot_token_here

# Admin chat id (where leads land). Single id or comma-separated list:
#   ADMIN_CHAT_ID=123456789
#   ADMIN_CHAT_ID=123456789,-1001234567890
ADMIN_CHAT_ID=put_your_chat_id_here

# Comma-separated list of allowed origins for CORS.
# Default keeps GitHub Pages + the project's nip.io subdomain.
ALLOWED_ORIGINS=https://zay1d.github.io

# Optional: minimum seconds between two leads from the same TG user
RATE_LIMIT_SECONDS=30
